enum Plan {
  free
  growth
  pro
}

enum OrderStatus {
  pending_payment
  customer_claims_paid
  vendor_confirmed
  fulfilled
  vendor_disputed
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id
  email     String   @unique
  shop      Shop?
  createdAt DateTime @default(now())
}

model Shop {
  id             String    @id @default(cuid())
  ownerId        String    @unique
  owner          User      @relation(fields: [ownerId], references: [id])
  shopName       String
  slug           String    @unique
  whatsappNumber String
  description    String    @default("")
  logoUrl        String    @default("")
  products       Product[]
  orders         Order[]
  checkoutIntents CheckoutIntent[]   // ← add this line

  plan             Plan      @default(free)
  planActivatedAt  DateTime?
  lastPaystackRef  String?

  // Payment details — optional at storefront creation
  bankName              String?
  accountName           String?
  accountNumber         String?
  paymentInstructions   String?
  paymentUpdatedAt      DateTime?

  isActive       Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id       String @id @default(cuid())
  orderRef String @unique  // short public code, e.g. "A2K9F1" — display only, shown in WhatsApp message text. NOT used for lookups/links (see receipt page, which uses id).

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  items Json

  customerName    String
  customerPhone   String
  customerAddress String

  total     Int

  paymentBankName      String?
  paymentAccountName   String?
  paymentAccountNumber String?
  paymentInstructions  String?

  status    OrderStatus @default(pending_payment)

  createdAt DateTime @default(now())
}



model Product {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name       String
  price      Int
  imageUrl   String   @default("")
  available  Boolean  @default(true)
  stock      Int?
  negotiable Boolean  @default(false)
  createdAt  DateTime @default(now())
}


model CheckoutIntent {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  customerName  String
  customerPhone String
  items         Json
  total         Int

  // Flips true once a real Order comes in from the same phone number —
  // lets the vendor see "this one came back and bought" vs still-open leads.
  recovered     Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // One row per customer per shop — if they come back with a different
  // cart, we just update the existing row rather than piling up duplicates.
  @@unique([shopId, customerPhone])
}